# Default: normalize text files
* text=auto

# MBBS message and module definition files are binary-sensitive CP437 text
# and must keep CRLF line endings (the CNF editor cannot parse LF files).
*.MSG -text
*.msg -text
*.MDF text eol=crlf
*.RLN text eol=crlf
*.mdf text eol=crlf

# Btrieve data files
*.VIR binary
*.DAT binary

# Windows build files
*.vcxproj text eol=crlf
*.filters text eol=crlf
*.props text eol=crlf
*.example text eol=crlf
*.sln text eol=crlf
*.RC text eol=crlf
*.rc text eol=crlf
*.DEF text eol=crlf
*.def text eol=crlf
*.C text eol=crlf
*.H text eol=crlf
*.c text eol=crlf
*.h text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
