/* SNBETNWS.RC - Windows version resource for SNBETNWS.DLL */
/* The version numbers come from BNVER.H, the single source of truth. */

#include <winver.h>
#include "BNVER.H"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    BNVER_NUMS
 PRODUCTVERSION BNVER_NUMS
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sysop Network"
            VALUE "FileDescription",  "Better Newsgroups for The Major BBS v10"
            VALUE "FileVersion",      BNVER_DOTTED
            VALUE "InternalName",     BNMODNAME
            VALUE "LegalCopyright",   BNCOPYRIGHT
            VALUE "OriginalFilename", "SNBETNWS.DLL"
            VALUE "ProductName",      BNPRODUCT
            VALUE "ProductVersion",   BNVER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
